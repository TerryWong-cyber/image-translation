# Copy this file to .env and adjust values for the current environment.
# Environment variables provided by the process take precedence over .env.

# FastAPI / Uvicorn
SERVER_APP=image_translation.api.main:app
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_RELOAD_DIRS=src
API_IMAGE_TRANSLATE_PATH=/llm/image-translate

# MCP Streamable HTTP (secure localhost defaults)
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,http://[::1],http://[::1]:*
MCP_MAX_REQUEST_BODY_SIZE=1048576
MCP_MAX_CONCURRENCY=2

# Shared outbound HTTP client
HTTP_REQUEST_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=3

# LLM/VLM upstream services
LLM_API_BASE_URL=http://127.0.0.1:5051
LLM_LEGACY_API_BASE_URL=http://127.0.0.1:5050
LLM_TRANSLATION_ENDPOINT=/api/inference/qwen_translate
LLM_LEGACY_INFERENCE_ENDPOINT=/api/inference
LLM_RECOGNITION_ENDPOINT=/api/qwen_vl/generate
LLM_RECOGNITION_BATCH_ENDPOINT=/api/qwen_vl/generate_batch
LLM_TRANSLATION_TIMEOUT_SECONDS=30
LLM_RECOGNITION_TIMEOUT_SECONDS=60
LLM_MAX_NEW_TOKENS=1000
LLM_BATCH_SIZE=1

# Prompt templates
PROMPTS_DIR=configs/prompts

# Object-storage HTTP service
OSS_BASE_URL=http://127.0.0.1:5000
OSS_UPLOAD_ENDPOINT=/upload
OSS_FILE_ENDPOINT=/file/{bucket}/{key}

# OCR runtime
OCR_DEVICE=cpu
OCR_GPU_ID=0
OCR_LANGUAGE=en
OCR_VERSION=PP-OCRv4
OCR_USE_ANGLE_CLASSIFIER=true
OCR_DET_DB_UNCLIP_RATIO=1.5
OCR_REQUIRE_LOCAL_MODELS=false
OCR_TEXTLINE_MODEL_DIR=
OCR_DETECTION_MODEL_DIR=
OCR_RECOGNITION_MODEL_DIR=
OCR_TASK_TIMEOUT_SECONDS=180
OCR_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
OCR_BOX_HEIGHT_TOLERANCE_RATIO=0.7

# Text filtering
NO_TRANSLATE_TERMS_FILE=configs/no_translate_terms.json

# Runtime/test file locations
FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-Regular.ttf
TEST_INPUT_DIR=tests/fixtures/input
TEST_OUTPUT_DIR=tests/output/ocr
TEST_TRANSLATION_OUTPUT_DIR=tests/output/translation
