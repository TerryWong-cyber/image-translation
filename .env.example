# Copy this file to .env and adjust values for the current environment.
# Environment variables provided by the process take precedence over .env.

# FastAPI / Uvicorn
SERVER_APP=image_translation.api.main:app
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_RELOAD_DIRS=src
API_IMAGE_TRANSLATE_PATH=/llm/image-translate
# Internal raw-image endpoint is disabled unless explicitly enabled with a token.
API_BINARY_ENABLED=false
API_BINARY_TOKEN=
API_MAX_IMAGE_BYTES=20971520
API_MAX_IMAGE_PIXELS=40000000
API_DOWNLOAD_TIMEOUT_SECONDS=15
API_MAX_REDIRECTS=3

# MCP Streamable HTTP (secure localhost defaults)
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,http://[::1],http://[::1]:*
MCP_MAX_REQUEST_BODY_SIZE=1048576
MCP_MAX_CONCURRENCY=2

# Shared outbound HTTP client
HTTP_REQUEST_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=3

# LLM/VLM upstream services
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_MODEL=gemma4-26b-a4b
LLM_API_KEY=
LLM_API_BASE_URL=http://127.0.0.1:5051
LLM_TRANSLATION_TIMEOUT_SECONDS=30
LLM_RECOGNITION_TIMEOUT_SECONDS=60
LLM_MAX_NEW_TOKENS=1000
LLM_BATCH_SIZE=1

# Prompt templates
PROMPTS_DIR=configs/prompts

# Object-storage HTTP service

# OCR runtime
OCR_DEVICE=cpu
OCR_GPU_ID=0
OCR_LANGUAGE=en
OCR_VERSION=PP-OCRv4
OCR_USE_ANGLE_CLASSIFIER=true
OCR_DET_DB_UNCLIP_RATIO=1.5
OCR_REQUIRE_LOCAL_MODELS=false
OCR_TEXTLINE_MODEL_DIR=
OCR_DETECTION_MODEL_DIR=
OCR_RECOGNITION_MODEL_DIR=
OCR_TASK_TIMEOUT_SECONDS=180
OCR_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
OCR_BOX_HEIGHT_TOLERANCE_RATIO=0.7

# Text filtering
NO_TRANSLATE_TERMS_FILE=configs/no_translate_terms.json

# Translation fonts. FONT_FILE is the compatibility fallback for unset entries.
FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-Regular.ttf
FONT_ZH_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-Regular.ttf
FONT_ZH_CN_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-Regular.ttf
FONT_ZH_TW_FILE=/usr/share/fonts/opentype/noto/NotoSansTC-Regular.ttf
FONT_LATIN_FILE=/usr/share/fonts/opentype/noto/NotoSans-Regular.ttf
FONT_JA_FILE=/usr/share/fonts/opentype/noto/NotoSansJP-Regular.ttf
FONT_KO_FILE=/usr/share/fonts/opentype/noto/NotoSansKR-Regular.ttf
FONT_ARABIC_FILE=/usr/share/fonts/opentype/noto/NotoSansArabic-Regular.ttf
FONT_CYRILLIC_FILE=/usr/share/fonts/opentype/noto/NotoSansCyrillic-Regular.ttf
FONT_THAI_FILE=/usr/share/fonts/opentype/noto/NotoSansThai-Regular.ttf
FONT_VIETNAMESE_FILE=/usr/share/fonts/opentype/noto/NotoSansVietnamese-Regular.ttf

# Runtime/test file locations
TEST_INPUT_DIR=tests/fixtures/input
TEST_OUTPUT_DIR=tests/output/ocr
TEST_TRANSLATION_OUTPUT_DIR=tests/output/translation

# Central file storage: origin only, never append /api or /file.
FILE_SERVICE_BASE_URL=https://game.toolup.cn
FILE_SERVICE_TOKEN=
# Use default unless the namespace is explicitly configured on File Service.
FILE_SERVICE_STORAGE_NAMESPACE=default
FILE_SERVICE_TIMEOUT_SECONDS=120

# Optional cross-tool task tracking (or use a generated .env.task-service).
# Leave the base URL empty to preserve standalone operation.
TASK_SERVICE_BASE_URL=
TASK_SERVICE_TOKEN=
TASK_SERVICE_OWNER_ID=local
TASK_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/task_service
TASK_SERVICE_CONTEXT_TOKEN=
