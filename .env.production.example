# Copy to .env.production. This file contains no credentials.

SERVER_APP=image_translation.api.main:app
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_RELOAD_DIRS=src
API_IMAGE_TRANSLATE_PATH=/llm/image-translate

MCP_ENABLED=true
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
# Replace YOUR_HOSTNAME and origins before exposing MCP outside the host.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,image-translation,image-translation:*,YOUR_HOSTNAME
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,https://YOUR_HOSTNAME
MCP_MAX_REQUEST_BODY_SIZE=1048576
MCP_MAX_CONCURRENCY=2

HTTP_REQUEST_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=3

# host.docker.internal reaches services bound on this Linux Docker host.
# Replace these URLs when LLM/VLM services run on another host or Compose network.
LLM_API_BASE_URL=http://host.docker.internal:5051
LLM_LEGACY_API_BASE_URL=http://host.docker.internal:5050
LLM_TRANSLATION_ENDPOINT=/api/inference/qwen_translate
LLM_LEGACY_INFERENCE_ENDPOINT=/api/inference
LLM_RECOGNITION_ENDPOINT=/api/qwen_vl/generate
LLM_RECOGNITION_BATCH_ENDPOINT=/api/qwen_vl/generate_batch
LLM_TRANSLATION_TIMEOUT_SECONDS=30
LLM_RECOGNITION_TIMEOUT_SECONDS=60
LLM_MAX_NEW_TOKENS=1000
LLM_BATCH_SIZE=1

PROMPTS_DIR=/app/configs/prompts

OSS_BASE_URL=http://host.docker.internal:5000
OSS_UPLOAD_ENDPOINT=/upload
OSS_FILE_ENDPOINT=/file/{bucket}/{key}

OCR_DEVICE=gpu
# NVIDIA_VISIBLE_DEVICES selects the physical GPU; it is remapped to index 0 here.
OCR_GPU_ID=0
OCR_LANGUAGE=en
OCR_VERSION=PP-OCRv4
OCR_USE_ANGLE_CLASSIFIER=true
OCR_DET_DB_UNCLIP_RATIO=1.5
OCR_REQUIRE_LOCAL_MODELS=true
OCR_TEXTLINE_MODEL_DIR=/opt/paddlex-cache/official_models/PP-LCNet_x1_0_textline_ori
OCR_DETECTION_MODEL_DIR=/opt/paddlex-cache/official_models/PP-OCRv4_mobile_det
OCR_RECOGNITION_MODEL_DIR=/opt/paddlex-cache/official_models/en_PP-OCRv4_mobile_rec
OCR_TASK_TIMEOUT_SECONDS=180
OCR_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
OCR_BOX_HEIGHT_TOLERANCE_RATIO=0.7

NO_TRANSLATE_TERMS_FILE=/app/configs/no_translate_terms.json
FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
TEST_INPUT_DIR=/tmp/image-translation/input
TEST_OUTPUT_DIR=/tmp/image-translation/ocr-output
TEST_TRANSLATION_OUTPUT_DIR=/tmp/image-translation/translation-output
